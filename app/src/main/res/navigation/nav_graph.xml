<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/customerFragment">

    <fragment
        android:id="@+id/customerFragment"
        android:name="com.example.hisabkitaab.ui.customer.CustomerFragment"
        android:label="Customer">
        <action
            android:id="@+id/action_customerFragment_to_customerDetailFragment"
            app:destination="@id/customerDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerDetailFragment"
        android:name="com.example.hisabkitaab.ui.customer.CustomerDetailFragment"
        android:label="Customer Detail">
        <action
            android:id="@+id/action_customerDetailFragment_to_transactionDetailFragment"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.hisabkitaab.ui.transaction.TransactionDetailFragment"
        android:label="Transaction Detail">
        <action
            android:id="@+id/action_transactionDetailFragment_to_transactionEntryFragment"
            app:destination="@id/transactionEntryFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionEntryFragment"
        android:name="com.example.hisabkitaab.ui.transaction.TransactionEntryFragment"
        android:label="Transaction Entry" />

</navigation>
